{
  "schema": "ariami-connect-p0-fault-matrix",
  "slices": [
    {
      "slice": 2,
      "coverage": "complete",
      "probes": [
        "half_open_socket",
        "bounded_connect_wait",
        "bounded_refresh_close",
        "unbounded_dispose_wait",
        "stale_socket_callback",
        "authentication_4001_reconnects",
        "reconnect_backoff_resets",
        "replaced_4000_reconnects"
      ],
      "failureModes": [
        {
          "name": "half-open socket remains connected",
          "probe": "half_open_socket"
        },
        {
          "name": "connect readiness never completes",
          "probe": "bounded_connect_wait"
        },
        {
          "name": "refresh close never completes",
          "probe": "bounded_refresh_close"
        },
        {
          "name": "dispose close never completes",
          "probe": "unbounded_dispose_wait"
        },
        {
          "name": "old socket callback closes its replacement",
          "probe": "stale_socket_callback"
        },
        {
          "name": "authentication close 4001 reconnects forever",
          "probe": "authentication_4001_reconnects"
        },
        {
          "name": "repeated transient reconnect never increases backoff",
          "probe": "reconnect_backoff_resets"
        },
        {
          "name": "close 4000 replacement starts a reconnect fight",
          "probe": "replaced_4000_reconnects"
        }
      ]
    },
    {
      "slice": 3,
      "coverage": "complete",
      "probes": [
        "monotonic_owner_epoch",
        "same_owner_reclaim_retains_epoch",
        "stale_state_rejected",
        "simultaneous_takeovers_converge",
        "stale_command_rejected",
        "epoch_change_fails_pending_command",
        "stale_transfer_rejected",
        "former_owner_pauses_before_mirror",
        "controller_observer_keeps_playing",
        "stale_client_work_rejected",
        "epoch_wire_propagation",
        "legacy_v2_epoch_omission"
      ],
      "failureModes": [
        {
          "name": "hub does not mint a monotonic epoch on committed ownership",
          "probe": "monotonic_owner_epoch"
        },
        {
          "name": "same owner reconnect or grace reclaim advances the epoch",
          "probe": "same_owner_reclaim_retains_epoch"
        },
        {
          "name": "stale owner publishes queue or state",
          "probe": "stale_state_rejected"
        },
        {
          "name": "simultaneous takeovers do not converge to one owner",
          "probe": "simultaneous_takeovers_converge"
        },
        {
          "name": "stale controller sends a command",
          "probe": "stale_command_rejected"
        },
        {
          "name": "ownership change leaves a pending command ambiguous",
          "probe": "epoch_change_fails_pending_command"
        },
        {
          "name": "stale target commits a transfer",
          "probe": "stale_transfer_rejected"
        },
        {
          "name": "former owner adopts the mirror before local audio pauses",
          "probe": "former_owner_pauses_before_mirror"
        },
        {
          "name": "controller-only observer is paused by another device handoff",
          "probe": "controller_observer_keeps_playing"
        },
        {
          "name": "upgraded client accepts stale state or command work",
          "probe": "stale_client_work_rejected"
        },
        {
          "name": "state command or transfer omits the owner epoch",
          "probe": "epoch_wire_propagation"
        },
        {
          "name": "epoch enforcement disconnects an older v2 peer",
          "probe": "legacy_v2_epoch_omission"
        }
      ]
    },
    {
      "slice": 4,
      "coverage": "complete",
      "probes": [
        "client_protocol_advertisement",
        "pre_auth_hello_retained",
        "per_peer_protocol_selection",
        "v3_preserves_v2_snapshots",
        "v3_negotiation_disabled",
        "legacy_v2_negotiation_fallback",
        "malformed_protocol_offer"
      ],
      "failureModes": [
        {
          "name": "upgraded client does not advertise v3 and v2",
          "probe": "client_protocol_advertisement"
        },
        {
          "name": "hello racing asynchronous authentication is discarded",
          "probe": "pre_auth_hello_retained"
        },
        {
          "name": "protocol version is not negotiated per peer",
          "probe": "per_peer_protocol_selection"
        },
        {
          "name": "v3 negotiation changes v2 snapshot semantics",
          "probe": "v3_preserves_v2_snapshots"
        },
        {
          "name": "v3 cannot be disabled independently",
          "probe": "v3_negotiation_disabled"
        },
        {
          "name": "legacy v2 peer no longer receives the established welcome",
          "probe": "legacy_v2_negotiation_fallback"
        },
        {
          "name": "a malformed protocol offer prevents the peer from registering",
          "probe": "malformed_protocol_offer"
        }
      ]
    },
    {
      "slice": 5,
      "coverage": "complete",
      "probes": [
        "v3_queue_crosses_once",
        "progress_coalesced_one_second",
        "canonical_queue_fingerprint",
        "positional_duplicate_backing_order",
        "mixed_v2_v3_convergence",
        "queue_not_resent_before_ack"
      ],
      "failureModes": [
        {
          "name": "progress resends the complete queue",
          "probe": "v3_queue_crosses_once"
        },
        {
          "name": "ordinary progress is not coalesced to approximately one hertz",
          "probe": "progress_coalesced_one_second"
        },
        {
          "name": "queue identity changes without a canonical queue change",
          "probe": "canonical_queue_fingerprint"
        },
        {
          "name": "duplicate track occurrences corrupt positional backing order",
          "probe": "positional_duplicate_backing_order"
        },
        {
          "name": "mixed v2 and v3 reconstruction diverges",
          "probe": "mixed_v2_v3_convergence"
        },
        {
          "name": "progress repeats a queue awaiting hub acknowledgement",
          "probe": "queue_not_resent_before_ack"
        }
      ]
    },
    {
      "slice": 6,
      "coverage": "complete",
      "probes": [
        "capabilities_advertised",
        "unsupported_command_fails_explicitly",
        "pending_takeover_cancellation",
        "four_client_capability_parity"
      ],
      "failureModes": [
        {
          "name": "client command capabilities are absent or expand the protocol allowlist",
          "probe": "capabilities_advertised"
        },
        {
          "name": "unsupported command reports success or times out",
          "probe": "unsupported_command_fails_explicitly"
        },
        {
          "name": "pending takeover is dropped or cannot be cancelled",
          "probe": "pending_takeover_cancellation"
        },
        {
          "name": "set_volume clear_queue or takeover behaviour differs across clients",
          "probe": "four_client_capability_parity"
        }
      ]
    },
    {
      "slice": 7,
      "coverage": "complete",
      "probes": [
        "raw_message_limit",
        "bounded_command_shapes",
        "oversized_play_context",
        "target_socket_replacement",
        "small_retry_envelope",
        "target_execution_idempotent",
        "epoch_change_fails_pending_command",
        "command_overflow",
        "command_timeout",
        "retry_exhaustion",
        "optimistic_reconciliation",
        "play_context_backing_order",
        "four_client_reliable_command_parity"
      ],
      "failureModes": [
        {
          "name": "raw message is decoded before a size limit",
          "probe": "raw_message_limit"
        },
        {
          "name": "queue strings nesting or arguments are unbounded",
          "probe": "bounded_command_shapes"
        },
        {
          "name": "play_context overflow has no explicit failure",
          "probe": "oversized_play_context"
        },
        {
          "name": "target socket replacement loses a command",
          "probe": "target_socket_replacement"
        },
        {
          "name": "controller retries resend the full payload",
          "probe": "small_retry_envelope"
        },
        {
          "name": "retry executes a command more than once",
          "probe": "target_execution_idempotent"
        },
        {
          "name": "ownership change leaves command result ambiguous",
          "probe": "epoch_change_fails_pending_command"
        },
        {
          "name": "pending command overflow is silent",
          "probe": "command_overflow"
        },
        {
          "name": "hub timeout is not explicit",
          "probe": "command_timeout"
        },
        {
          "name": "retry exhaustion is silent",
          "probe": "retry_exhaustion"
        },
        {
          "name": "failed commands leave optimistic state sticky",
          "probe": "optimistic_reconciliation"
        },
        {
          "name": "play_context drops known backing order",
          "probe": "play_context_backing_order"
        },
        {
          "name": "reliable command behavior differs across clients",
          "probe": "four_client_reliable_command_parity"
        }
      ]
    },
    {
      "slice": 8,
      "coverage": "complete",
      "probes": [
        "handoff_semantic_generation",
        "handoff_progress_is_not_semantic",
        "prepared_target_restored",
        "current_transfer_only",
        "handoff_actions_idempotent",
        "handoff_cancel_paths"
      ],
      "failureModes": [
        {
          "name": "pause play seek skip queue shuffle repeat or volume change is overwritten",
          "probe": "handoff_semantic_generation"
        },
        {
          "name": "ordinary progress is mistaken for a semantic change",
          "probe": "handoff_progress_is_not_semantic"
        },
        {
          "name": "natural track transition is overwritten",
          "probe": "handoff_semantic_generation"
        },
        {
          "name": "failed or superseded prepare destroys target local state",
          "probe": "prepared_target_restored"
        },
        {
          "name": "stale transfer id commits",
          "probe": "current_transfer_only"
        },
        {
          "name": "source relinquishment or target start runs more than once",
          "probe": "handoff_actions_idempotent"
        },
        {
          "name": "timeout rejection supersede or disconnect leaves target prepared",
          "probe": "handoff_cancel_paths"
        }
      ]
    },
    {
      "slice": 9,
      "coverage": "complete",
      "probes": [
        "reclaim_grace_policy",
        "recent_controller_inherits_playing",
        "connection_recency_falls_back_paused",
        "stale_controller_falls_back_paused",
        "failed_failover_tries_next",
        "failover_exhaustion_settles_paused",
        "former_owner_reconnects_paused"
      ],
      "failureModes": [
        {
          "name": "owner grace is not centralized",
          "probe": "reclaim_grace_policy"
        },
        {
          "name": "a recent controller cannot safely inherit playing state",
          "probe": "recent_controller_inherits_playing"
        },
        {
          "name": "connection recency selects a playing replacement",
          "probe": "connection_recency_falls_back_paused"
        },
        {
          "name": "inactive controller older than policy inherits playing",
          "probe": "stale_controller_falls_back_paused"
        },
        {
          "name": "failed candidate prevents trying the next candidate",
          "probe": "failed_failover_tries_next"
        },
        {
          "name": "candidate exhaustion does not settle paused",
          "probe": "failover_exhaustion_settles_paused"
        },
        {
          "name": "a former owner reconnects after failover without pausing",
          "probe": "former_owner_reconnects_paused"
        }
      ]
    },
    {
      "slice": 10,
      "coverage": "representative",
      "probe": "empty_session_is_retained",
      "failureModes": [
        "idle session is retained without peers or transitions",
        "long-lived authentication is not revalidated",
        "equal display names have unstable ordering",
        "recovery failover or mixed-version behavior is undocumented"
      ]
    }
  ]
}
